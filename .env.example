# Live AI assistant (server-side only — never expose these in browser code).
OPENAI_API_KEY=sk-REPLACE_ME
# Leave empty for the default, gpt-5.6 (the alias for gpt-5.6-sol).
# gpt-5.6-terra is the cheaper balanced option, gpt-5.6-luna the cheapest.
OPENAI_MODEL=

# Optional: direct application-to-LemmaBase reads. Leave empty to run purely on
# the captured published snapshots in policies/snapshots (the default, and what
# the presentation uses).
LEMMABASE_API_KEY=
LEMMABASE_BASE_URL=https://lemmabase.com

# Shared password in front of the whole prototype. Local development runs open
# when this is unset; a production server refuses to serve without it.
DEMO_PASSWORD=
